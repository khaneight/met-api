{
  "name": "met-recent-works",
  "version": "0.1.0",
  "private": true,
  "description": "API server returning the most recent Met Museum works for a search term",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:memory": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "NODE_ENV=production node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "ioredis": "^5.11.1",
    "lru-cache": "^11.5.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/ioredis-mock": "^8.2.8",
    "@types/node": "^26.6.2",
    "ioredis-mock": "^8.13.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
